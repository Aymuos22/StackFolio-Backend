# Copy this file to .env for local Docker runs.
# Do not commit real secrets.

SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
APP_PORT=8080

DATABASE_URL=jdbc:postgresql://host.docker.internal:5432/stackfolio
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ACCESS_TOKEN_TTL_SECONDS=3600

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
SWAGGER_ENABLED=false

RESEND_API_KEY=
RESEND_FROM_EMAIL=

UPSTASH_REDIS_HOST=
UPSTASH_REDIS_PORT=6379
UPSTASH_REDIS_PASSWORD=
UPSTASH_REDIS_SSL=true

PASSWORD_RESET_OTP_TTL_SECONDS=300
PASSWORD_RESET_COOLDOWN_SECONDS=60
PASSWORD_RESET_MAX_ATTEMPTS=5

AUTH_RATE_LIMIT_MAX_REQUESTS=20
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Cloudflare R2 (S3-compatible) for profile images
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public media base (API proxy). Prod example:
# https://stackfolio-backend.onrender.com/api/media
R2_PUBLIC_BASE_URL=
R2_MAX_FILE_SIZE_BYTES=5242880

# Groq (OpenAI-compatible) for portfolio suggest
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
